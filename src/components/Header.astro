---
interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

const links = [
  { href: '/', label: 'Inicio', key: 'inicio' },
  { href: '/propiedades', label: 'Propiedades', key: 'propiedades' },
  { href: '/sobre-mi', label: 'Sobre mí', key: 'sobre-mi' },
  { href: '/contacto', label: 'Contacto', key: 'contacto' },
];
---
<header class="sticky top-0 z-40 w-full border-b border-stone-200 bg-paper/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 md:px-12">
    <a href="/" class="flex items-center gap-3">
      <span class="flex h-10 w-10 items-center justify-center rounded-sm bg-navy-800 font-display text-sm font-semibold text-gold-light">
        ML<span class="text-gold">·</span>JV
      </span>
      <span class="hidden font-display text-lg font-semibold leading-none text-navy-900 sm:block">
        ML y JV<br class="hidden lg:block"/> <span class="font-body text-xs font-normal tracking-wide text-stone-600">Corretajes e Inversiones</span>
      </span>
    </a>

    <nav class="hidden items-center gap-9 font-ui text-sm font-medium text-stone-600 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class={`relative py-1 transition-colors hover:text-navy-900 ${
            active === l.key ? 'text-navy-900' : ''
          }`}
        >
          {l.label}
          {active === l.key && (
            <span class="absolute -bottom-[17px] left-0 h-[2px] w-full bg-gold"></span>
          )}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="tel:+56912345678" class="btn-primary hidden md:inline-flex">
        Llamar ahora
      </a>
      <button
        id="menu-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        class="flex h-10 w-10 items-center justify-center rounded-sm border border-stone-200 text-navy-900 md:hidden"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-stone-200 bg-paper md:hidden">
    <nav class="flex flex-col gap-1 px-5 py-4 font-ui text-base font-medium text-stone-700">
      {links.map((l) => (
        <a
          href={l.href}
          class={`rounded-sm px-3 py-3 transition-colors hover:bg-navy-800/5 ${
            active === l.key ? 'bg-navy-800/5 text-navy-900' : ''
          }`}
        >
          {l.label}
        </a>
      ))}
      <a href="tel:+56912345678" class="btn-primary mt-2 w-full">Llamar ahora</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!!isHidden));
  });
</script>
