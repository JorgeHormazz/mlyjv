---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import Coordinates from '../components/Coordinates.astro';

const contactItems = [
  {
    label: 'Teléfono',
    value: '+56 9 1234 5678',
    href: 'tel:+56912345678',
    icon: 'M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 002.25-2.25v-1.372a1.5 1.5 0 00-1.086-1.442l-4.02-1.148a1.5 1.5 0 00-1.588.44l-.723.88a11.24 11.24 0 01-5.62-5.62l.88-.723a1.5 1.5 0 00.44-1.588L8.164 3.336A1.5 1.5 0 006.722 2.25H5.25A2.25 2.25 0 003 4.5v2.25z',
  },
  {
    label: 'Email',
    value: 'contacto@mlyjv.cl',
    href: 'mailto:contacto@mlyjv.cl',
    icon: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.01 1.877l-7.5 5.006a2.25 2.25 0 01-2.48 0L3.26 8.87a2.25 2.25 0 01-1.01-1.877V6.75',
  },
  {
    label: 'Oficina',
    value: 'Av. Libertad 123, Of. 45, Chillán, Ñuble',
    href: undefined,
    icon: 'M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z',
  },
];
---
<Layout title="Contacto" active="contacto" description="Escríbenos, llama o visita nuestra oficina en Chillán. Asesoría inmobiliaria personalizada en la Región de Ñuble.">
  <section class="mx-auto max-w-7xl px-5 py-16 text-center md:px-12">
    <Coordinates class="mb-4 justify-center" />
    <h1 class="font-display text-4xl font-semibold text-navy-900 md:text-5xl">Hablemos</h1>
    <p class="mx-auto mt-4 max-w-xl font-body text-stone-600">
      Estamos aquí para asesorarle de manera personalizada en su próxima inversión
      inmobiliaria en la Región de Ñuble.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-5 pb-24 md:grid-cols-12 md:px-12">
    <div class="rounded-sm border border-stone-200 bg-white p-6 shadow-card md:col-span-7 md:p-10">
      <h2 class="mb-6 font-display text-2xl font-semibold text-navy-900">Envíanos un mensaje</h2>
      <ContactForm />
    </div>

    <div class="flex flex-col gap-8 md:col-span-5">
      <div class="rounded-sm border border-stone-200 bg-white p-6 shadow-card md:p-8">
        <h3 class="mb-6 font-display text-xl font-semibold text-navy-900">Información directa</h3>
        <div class="flex flex-col gap-5">
          {contactItems.map((item, i) => (
            <>
              <div class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-navy-800/5 text-navy-800">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                  </svg>
                </span>
                <div>
                  <p class="font-ui text-[11px] font-semibold uppercase tracking-widest2 text-stone-500">{item.label}</p>
                  {item.href ? (
                    <a href={item.href} class="font-body text-navy-900 transition-colors hover:text-gold-dark">{item.value}</a>
                  ) : (
                    <p class="font-body text-navy-900">{item.value}</p>
                  )}
                </div>
              </div>
              {i < contactItems.length - 1 && <div class="h-px w-full bg-stone-100"></div>}
            </>
          ))}
        </div>
      </div>

      <div class="relative h-64 overflow-hidden rounded-sm border border-stone-200 shadow-card">
        <iframe
          title="Mapa de Chillán, Ñuble"
          class="h-full w-full grayscale"
          src="https://www.google.com/maps?q=Chill%C3%A1n,%20%C3%91uble,%20Chile&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <div class="pointer-events-none absolute inset-x-4 bottom-4 rounded-sm bg-white/90 px-4 py-2 text-center font-ui text-xs font-semibold text-navy-900 shadow-sm">
          Operando en toda la Región de Ñuble
        </div>
      </div>
    </div>
  </section>
</Layout>
